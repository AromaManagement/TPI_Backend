generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------
// ENUMS
// ----------------------------

enum Rol {
  ADMIN
  CLIENTE
  COCINERO
  REPARTIDOR
}

enum EstadoComanda {
  SIN_PAGAR
  SIN_ASIGNAR
  EN_COCINA
  LISTO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum EstadoDetalle {
  SIN_ASIGNAR
  EN_COCINA
  LISTO
}

enum TipoMov {
  INGRESO
  EGRESO
  AJUSTE
  MERMA
}

enum UnidadMedida {
  KG
  G
  L
  ML
  UNIDAD
  PORCION
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  CANCELADO
}

enum MetodoPago {
  EFECTIVO
  MERCADOPAGO
}

// ----------------------------
// LOCALIDAD
// ----------------------------
model Localidad {
  id        Int       @id @default(autoincrement())
  nombre    String    @db.VarChar(150)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("localidad")
}

// ----------------------------
// DIRECCION
// ----------------------------
model Direccion {
  id          Int       @id @default(autoincrement())
  barrio      String?   @db.VarChar(150)
  calle       String?   @db.VarChar(150)
  manzanaPiso String?   @map("manzana_piso") @db.VarChar(50)
  numeracion  String?   @db.VarChar(20)
  referencia  String?   @db.VarChar(255)
  casaDepto   String?   @map("casa_depto") @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  usuarios Usuario[]
  comandas Comanda[]

  @@map("direccion")
}

// ----------------------------
// USUARIO
// ----------------------------
model Usuario {
  id            Int       @id @default(autoincrement())
  contrasena    String    @db.VarChar(255)
  correo        String    @unique @db.VarChar(150)
  nombre        String    @db.VarChar(100)
  apellido      String    @db.VarChar(100)
  tipoDocumento String?   @map("tipo_documento") @db.VarChar(50)
  documento     String?   @db.VarChar(50)
  nacimiento    DateTime? @db.Date
  direccionId   Int?      @map("direccion_id")
  rol           Rol       @map("rol")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  direccion         Direccion?       @relation(fields: [direccionId], references: [id])
  ClienteComanda    Comanda[]        @relation("ClienteComanda")
  DetalleComanda    DetalleComanda[]
  RepartidorComanda Comanda[]

  @@map("usuario")
}

// ----------------------------
// ARTICULO
// ----------------------------
model Articulo {
  id            Int           @id @default(autoincrement())
  nombre        String        @db.VarChar(150)
  descripcion   String?
  esIngrediente Boolean       @default(false) @map("es_ingrediente")
  unidadMedida  UnidadMedida? @map("unidad_medida")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  stock  Stock?
  platos PlatoArticulo[]

  @@map("articulo")
}

// ----------------------------
// STOCK
// ----------------------------
model Stock {
  id         Int       @id @default(autoincrement())
  articuloId Int       @unique @map("articulo_id")
  cantidad   Decimal   @default(0) @db.Decimal(10, 2)
  minimo     Decimal?  @db.Decimal(10, 2)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  articulo    Articulo          @relation(fields: [articuloId], references: [id])
  movimientos MovimientoStock[]

  @@map("stock")
}

// ----------------------------
// MOVIMIENTO STOCK
// ----------------------------
model MovimientoStock {
  id        Int       @id @default(autoincrement())
  stockId   Int       @map("stock_id")
  tipoMov   TipoMov   @map("tipo_mov")
  cantidad  Decimal   @db.Decimal(10, 2)
  fecha     DateTime  @db.Date
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  stock Stock @relation(fields: [stockId], references: [id])

  @@map("movimiento_stock")
}

// ----------------------------
// IMAGEN
// ----------------------------
model Imagen {
  id        Int       @id @default(autoincrement())
  imagenSi  String    @map("imagen_si") @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  platos Platos[]

  @@map("imagen")
}

// ----------------------------
// CARTA
// ----------------------------
model Carta {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  secciones Secciones[]

  @@map("carta")
}

// ----------------------------
// SECCIONES
// ----------------------------
model Secciones {
  id        Int       @id @default(autoincrement())
  cartaId   Int       @map("carta_id")
  nombre    String    @db.VarChar(150)
  detalle   String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  carta  Carta    @relation(fields: [cartaId], references: [id])
  platos Platos[]

  @@map("secciones")
}

// ----------------------------
// PLATOS
// ----------------------------
model Platos {
  id        Int       @id @default(autoincrement())
  seccionId Int       @map("seccion_id")
  nombre    String    @db.VarChar(150)
  precio    Decimal   @db.Decimal(10, 2)
  detalle   String?
  imagenId  Int?      @map("imagen_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  seccion         Secciones        @relation(fields: [seccionId], references: [id])
  imagen          Imagen?          @relation(fields: [imagenId], references: [id])
  articulos       PlatoArticulo[]
  detallesComanda DetalleComanda[]

  @@map("platos")
}

// ----------------------------
// PLATO <-> ARTICULO (N:M)
// ----------------------------
model PlatoArticulo {
  platoId    Int      @map("plato_id")
  articuloId Int      @map("articulo_id")
  cantidad   Decimal? @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  plato    Platos   @relation(fields: [platoId], references: [id])
  articulo Articulo @relation(fields: [articuloId], references: [id])

  @@id([platoId, articuloId])
  @@map("plato_articulo")
}

// ----------------------------
// COMANDA
// ----------------------------
model Comanda {
  id             Int            @id @default(autoincrement())
  clienteId      Int?           @map("cliente_id")
  estadoComanda  EstadoComanda? @map("estado_comanda")
  fechaSolicitud DateTime       @default(now()) @map("fecha_solicitud")
  fechaEntrega   DateTime?      @map("fecha_entrega")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")
  direccionId    Int?           @map("direccion_id")
  repartidorId   Int?           @map("repartidor_id")

  cliente    Usuario?         @relation(fields: [clienteId], references: [id], name: "ClienteComanda")
  detalles   DetalleComanda[]
  repartidor Usuario?         @relation(fields: [repartidorId], references: [id])
  direccion  Direccion?       @relation(fields: [direccionId], references: [id])
  pago       Pago?

  @@map("comanda")
}

// ----------------------------
// DETALLE COMANDA
// ----------------------------
model DetalleComanda {
  id             Int           @id @default(autoincrement())
  comandaId      Int           @map("comanda_id")
  empleadoId     Int?          @map("empleado_id")
  platoId        Int           @map("plato_id")
  precioUnitario Decimal       @db.Decimal(10, 2) @map("precio_unitario")
  estadoDetalle  EstadoDetalle @default(SIN_ASIGNAR) @map("estado_detalle")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  comanda  Comanda  @relation(fields: [comandaId], references: [id])
  plato    Platos   @relation(fields: [platoId], references: [id])
  empleado Usuario? @relation(fields: [empleadoId], references: [id])

  @@map("detalle_comanda")
}

// ----------------------------
// PAGO
// ----------------------------
model Pago {
  id          Int       @id @default(autoincrement())
  comandaId   Int       @unique @map("comanda_id")
  monto       Decimal   @db.Decimal(10, 2)
  metodoPago  String    @map("metodo_pago") @db.VarChar(50)
  proveedorId String?   @map("proveedor_id") @db.VarChar(100)
  estadoPago  String    @map("estado_pago") @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  comanda Comanda @relation(fields: [comandaId], references: [id])

  @@map("pago")
}
